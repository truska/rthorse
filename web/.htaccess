## Default CMS .htaccess (Reusable) [2025-08-19]
RewriteEngine On
RewriteBase /

# --- Custom error pages (local, dynamic host/protocol, normal site layout) ---
ErrorDocument 400 /error.php?status=400
ErrorDocument 401 /error.php?status=401
ErrorDocument 403 /error.php?status=403
ErrorDocument 404 /error.php?status=404
ErrorDocument 405 /error.php?status=405
ErrorDocument 500 /error.php?status=500
ErrorDocument 502 /error.php?status=502
ErrorDocument 503 /error.php?status=503

# --- Protect CSP log (if used) ---
<Files "csp-violations.log">
    Require all denied
</Files>

# --- Preserve HTTP Authorization headers (for APIs, CMS auth etc.) ---
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# --- Leave ACME/.well-known and robots.txt untouched ---
RewriteCond %{REQUEST_URI} ^/?\.well-known [NC,OR]
RewriteCond %{REQUEST_URI} ^/?robots\.txt$ [NC]
RewriteRule ^ - [L]

# --- Canonical host: force bare domain (strip www) ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

# --- Optional HTTPS enforcement (via marker file .force-https) ---
RewriteCond %{DOCUMENT_ROOT}/.force-https -f
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- WebP Auto-Serving (fallback if .jpg/.png has matching .webp) ---
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} (.*)\.(jpg|jpeg|png)$
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule (.*)\.(jpg|jpeg|png)$ $1.webp [T=image/webp,E=webp,L]
</IfModule>
<IfModule mod_headers.c>
    Header append Vary Accept
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
    # Placeholder CSP (to be managed dynamically by CMS)   
    ## --- CSP-POLICY-START ---

    ## --- CSP-POLICY-END ---

    # Send HSTS only on an actual HTTPS request. It is not a substitute for
    # the optional .force-https redirect above.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (feature restrictions)
    Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
</IfModule>

# --- CMS routing ---
RewriteRule ^/?$ /welcome [L,NC,QSA]
RewriteRule ^index(.*)$ /welcome [L,R=301]

# Send all other requests to inside.php (but not favicon, icons, or inside.php itself)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(favicon\.ico|apple-touch-icon.*\.png|inside\.php)$ [NC]
RewriteRule ^(.*)$ inside.php?url=$1 [QSA,L]
